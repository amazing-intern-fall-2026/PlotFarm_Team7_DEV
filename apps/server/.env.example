# ==============================================================================
# BACKEND SERVER ENVIRONMENT (.env.example)
# Đặt tại: apps/server/.env
# ==============================================================================

PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:6006"

# Chuỗi kết nối Cloud PostgreSQL (Neon.tech / Supabase)
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.ap-southeast-1.neon.tech/plotfarm_dev?sslmode=require"

# JWT Auth
JWT_SECRET="plotfarm_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="plotfarm_refresh_super_secret_jwt_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Single Sign-On (GIS / OAuth 2.0) — Client ID không phải bí mật, dùng chung.
GOOGLE_CLIENT_ID="157730877400-h04aalb5a1qkpvvrknm5frt9cp63635u.apps.googleusercontent.com"

# Verify Email (Resend: https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="PlotFarm <onboarding@resend.dev>"
EMAIL_VERIFY_REDIRECT_URL="http://localhost:3000/auth/verify-email"

# VietQR Config (https://vietqr.io)
VIETQR_BANK_ID="970422"
VIETQR_ACCOUNT_NO="0987654321"
VIETQR_ACCOUNT_NAME="CTY CP CONG NGHE PLOTFARM"
PAYMENT_WEBHOOK_SECRET="your_webhook_secret_here"    # Dùng để xác thực header x-api-key khi ngân hàng/SePay/Casso gọi webhook

# VNPay Sandbox (Tùy chọn: https://sandbox.vnpayment.vn)
VNP_TMN_CODE="YOUR_VNPAY_TMN_CODE"
VNP_HASH_SECRET="YOUR_VNPAY_HASH_SECRET"
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/checkout/vnpay-return"

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
