# ==============================================================================
# FRONTEND CLIENT ENVIRONMENT (.env.example)
# Đặt tại: apps/client/.env (hoặc cấu hình tại root .env)
# Lưu ý: Mọi biến dùng trong code React Vite đều bắt buộc có tiền tố VITE_
# ==============================================================================

# URL Client App
VITE_CLIENT_URL="http://localhost:3000"

# URL kết nối tới Backend API Express & Single Gateway
VITE_API_URL="http://localhost:5000/api"
VITE_GATEWAY_URL="http://localhost:5000/api/gateway"
VITE_GATEWAY_ENDPOINT="/api/gateway"

# Tên ứng dụng & Ký hiệu tiền tệ
VITE_APP_NAME="PlotFarm - Nông Trại Thông Minh"
VITE_CURRENCY_SYMBOL="đ"

# Google Single Sign-On (GIS / OAuth 2.0)
# Client ID không phải bí mật (luôn lộ trong JS chạy ở trình duyệt) nên để giá trị thật dùng chung.
VITE_GOOGLE_CLIENT_ID="157730877400-h04aalb5a1qkpvvrknm5frt9cp63635u.apps.googleusercontent.com"

# JWE Public Key (Dùng mã hóa 1 chiều payload client gửi lên Single Gateway)
VITE_JWE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAm4l+QIfCUMogC5SdFckO\noclkJiw4oMePI0hgoeMKPAfc1vXv2PR868nPvFfV2Y6jylloNSFI+XVh/hz7B5Hb\nGmpN6Ww+yjeibX03+5TYmuz0VRG/Q0nvMYS6kJPjXlP0wmti+iRVwEBQCgU96TQK\nxe/TsJQPxi/yX9uUKL9uL6lnoCok/u5MbhtLsjk5cn/lzjDSuTaRaBKlMeFr3yB4\nYFFR9niP4X33/Jk2QDKEa5lLNYNEbGspfJgV6k4HTbXP9PPV7Qlj0TcbRWhOLy9P\nV9z+yt+o+0d5TbndrY+wgtAaE0rUVXpS9QCmxYo5lTK9buNVlM20X7cwGQzJJEyg\n2wIDAQAB\n-----END PUBLIC KEY-----"

# Demo HLS Stream Video (Camera trực tiếp luống đất không cần lắp cam thật)
# Link test m3u8 chạy 24/7 mượt mà từ Mux: https://test-streams.mux.dev/
VITE_MOCK_STREAM_URL="https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8"

# Cloudinary Upload (cho Farmer upload ảnh chụp cây thực tế)
VITE_CLOUDINARY_CLOUD_NAME="your_cloud_name"
VITE_CLOUDINARY_UPLOAD_PRESET="plotfarm_farming_logs"

# Template đường dẫn tra cứu khi scan Barcode / QR trên phiếu gửi hàng A6
VITE_TRACKING_URL_TEMPLATE="http://localhost:3000/shipments/"
