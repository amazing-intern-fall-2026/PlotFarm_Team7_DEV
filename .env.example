# ==============================================================================
# PLOTFARM (BIO-CLOUD FARMING) — FULL STACK ENVIRONMENT CONFIGURATION (.env.example)
#
# HƯỚNG DẪN THAO TÁC NHANH DÀNH CHO CẢ NHÓM (FE & BE):
# 1. Tạo file .env từ file này bằng lệnh:
#    PowerShell:  Copy-Item .env.example .env
#    Bash/Linux:  cp .env.example .env
# 2. Đăng ký tài khoản tại các đường link bên dưới và dán key tương ứng.
# 3. Chạy lệnh đồng bộ Database lên Cloud:
#    pnpm --filter @repo/database db:push
# 4. Chạy toàn bộ hệ thống Monorepo:
#    pnpm dev
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLOUD DATABASE (PostgreSQL qua Prisma ORM)
# ------------------------------------------------------------------------------
# Link thao tác tạo DB miễn phí (30 giây xong):
# ➔ https://neon.tech  (Khuyên dùng số 1: Miễn phí, cực nhanh, chọn Region: Singapore)
# ➔ Hoặc: https://supabase.com
#
# Cách lấy chuỗi:
# - Sau khi tạo Project "plotfarm-dev" trên Neon.tech, copy chuỗi "Connection String" (chọn thẻ Prisma hoặc PostgreSQL)
# - Lưu ý: Luôn có đuôi ?sslmode=require khi kết nối Cloud DB
DATABASE_URL="postgresql://neondb_owner:your_neon_password@ep-cool-fog-123456.ap-southeast-1.neon.tech/plotfarm_dev?sslmode=require"

# ------------------------------------------------------------------------------
# 2. BACKEND API SERVER (apps/server)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:6006"

# JWT Authentication (Cấp Access Token 15 phút, Refresh Token 7 ngày)
JWT_SECRET="plotfarm_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="plotfarm_refresh_super_secret_jwt_key_2026"
JWT_REFRESH_EXPIRES_IN="7d"

